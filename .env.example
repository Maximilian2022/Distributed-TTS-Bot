# Discord Bot Tokens (1〜5号機プール)
DISCORD_TOKEN=your_primary_bot_token_here
# DISCORD_TOKEN_2=your_second_bot_token_here
# DISCORD_TOKEN_3=your_third_bot_token_here
# DISCORD_TOKEN_4=your_fourth_bot_token_here
# DISCORD_TOKEN_5=your_fifth_bot_token_here

# Azure AI Speech (Primary TTS Engine)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# Google Cloud Text-to-Speech (Fallback TTS Engine)
# サービスアカウントキーファイルを使用する場合はコンテナ内のパスを指定 (例: /app/data/gcp_key.json)
GOOGLE_APPLICATION_CREDENTIALS=
# または APIキーを使用する場合
GOOGLE_API_KEY=
# または サービスアカウントJSONの文字列をそのまま貼り付ける場合
GOOGLE_CREDENTIALS_JSON=

# Cloudflare Tunnel Token (ttsbot.kenko.land)
CLOUDFLARE_TUNNEL_TOKEN=

# Web UI & Discord OAuth2 Login (https://ttsbot.kenko.land)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://ttsbot.kenko.land/callback
WEB_SESSION_SECRET=
WEB_PORT=8080
