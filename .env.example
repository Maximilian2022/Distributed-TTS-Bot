# ==============================================================================
# TTSBot OSS 環境設定ファイル (.env)
#
# クイックスタート:
#   1. このファイルをコピーして .env を作成: cp .env.example .env
#   2. ADMIN_PASSWORD を設定
#   3. docker compose up -d を実行
#   4. ブラウザで http://localhost:8088 を開き、ADMIN_PASSWORD でログイン！
#   ※ BotトークンやクラウドAPIキーは、WebUI画面からGUIで後から登録・変更可能です。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WebUI 管理者パスワード (必須推奨)
# ------------------------------------------------------------------------------
# 初回起動時にDiscord OAuth2設定がなくても、このパスワードでWebUIへログインできます。
ADMIN_PASSWORD=change_this_to_a_secure_password

# 外部公開ベースURL (リダイレクトやWorkerワンライナー生成に使用)
# ローカル運用の場合は http://localhost:8088 または http://LAN_IP:8088
WEB_BASE_URL=http://localhost:8088

# ------------------------------------------------------------------------------
# 2. Discord Bot 設定 (WebUIからも登録可能)
# ------------------------------------------------------------------------------
# 1号機 (メイン代表Bot) のトークン
# ※ 未設定のまま起動しても、WebUIの「Bot管理」タブから後で登録・変更できます。
DISCORD_TOKEN=

# 2〜10号機 (多重通話スケーリング用ワーカーBot、必要に応じて設定)
# DISCORD_TOKEN_2=
# DISCORD_TOKEN_3=

# ------------------------------------------------------------------------------
# 3. Discord OAuth2 ログイン設定 (任意)
# ------------------------------------------------------------------------------
# サーバーメンバーにDiscordアカウントでWebUI（マイ音声設定等）を使わせたい場合に設定。
# Discord Developer Portal -> General Information / OAuth2 で取得。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8088/callback

# ------------------------------------------------------------------------------
# 4. クラウド音声合成 API (任意・WebUIからも登録可能)
# ------------------------------------------------------------------------------
# 未設定でも、無料かつ高品質な Edge-TTS (Microsoft Edge音声) と OpenJTalk で即座に動作します。

# Azure AI Speech (高音質・低遅延)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# Google Cloud Text-to-Speech (Journey/Neural2音声)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 5. 分散 GPU Worker 連携秘密鍵 (任意・WebUIからも登録可能)
# ------------------------------------------------------------------------------
# 自宅のゲーミングPCや別サーバーをWorkerとしてMasterへ外向きWebSocket接続する際の認証キー。
# 未設定の場合は起動時に自動生成されます。
WORKER_SHARED_SECRET=

# ------------------------------------------------------------------------------
# 6. Cloudflare Tunnel (任意・--profile tunnel 使用時)
# ------------------------------------------------------------------------------
# 自宅ルーターのポート開放不要で外部公開したい場合に使用。
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 7. Active-Standby HA (高可用性冗長化) 設定
# ------------------------------------------------------------------------------
# Master (主系) と Slave (副系) 間の暗号化DB同期・死活監視用シークレット
TTSBOT_HA_SECRET=

# Slave (Standby待機ノード) として動作させる場合の接続先Master URL
# TTSBOT_HA_ROLE=slave
# TTSBOT_MASTER_URL=https://ttsbot.example.com

